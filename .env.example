# The Court has no build step: the browser reads js/config.js, and these
# values are only used by scripts (scripts/write-config.sh, scripts/mp_setup.py).
# Public values (safe in the browser):
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Never in the browser, never committed. Not needed by the game at all:
# SUPABASE_SERVICE_ROLE_KEY=
# The setup script reads its Supabase personal access token from
# ~/.config/thecourt/supabase-token, outside the repository.
